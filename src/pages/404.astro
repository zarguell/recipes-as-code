---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This page could not be found.">

  <div class="not-found">
    <p class="code">404</p>
    <h1>This page isn't in the cookbook</h1>
    <p>The page you're looking for doesn't exist or may have moved.</p>
    <a href={import.meta.env.BASE_URL} class="button primary">Browse recipes</a>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 6rem 1rem;
  }

  .code {
    font-size: 5rem;
    font-weight: 800;
    color: var(--accent);
    margin: 0;
    line-height: 1;
  }

  h1 {
    margin: 1rem 0 0.5rem;
  }

  p {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent-2);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
  }

  .button:hover {
    filter: brightness(1.1);
    text-decoration: none;
  }
</style>

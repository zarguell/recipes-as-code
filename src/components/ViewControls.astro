---
---

<div class="view-controls">
  <div class="view-buttons">
    <button
      type="button"
      class="view-btn active"
      data-view="grid"
      title="Grid view"
      aria-pressed="true"
      aria-label="Grid view"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" />
        <rect x="14" y="3" width="7" height="7" />
        <rect x="14" y="14" width="7" height="7" />
        <rect x="3" y="14" width="7" height="7" />
      </svg>
    </button>
    <button
      type="button"
      class="view-btn"
      data-view="compact"
      title="Compact grid view"
      aria-pressed="false"
      aria-label="Compact grid view"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="7" />
        <rect x="3" y="14" width="18" height="7" />
      </svg>
    </button>
    <button
      type="button"
      class="view-btn"
      data-view="list"
      title="List view"
      aria-pressed="false"
      aria-label="List view"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x="8" y="6" x2="21" y2="6" />
        <line x="8" y="12" x2="21" y2="12" />
        <line x="8" y="18" x2="21" y2="18" />
        <line x="3" y="6" x2="3.01" y2="6" />
        <line x="3" y="12" x2="3.01" y2="12" />
        <line x="3" y="18" x2="3.01" y2="18" />
      </svg>
    </button>
  </div>
</div>

<script>
  // Single shared implementation — Astro bundles and dedupes this module
  // across every page that renders <ViewControls />.
  function setView(viewType: string) {
    const recipeGrid = document.getElementById('recipeGrid');
    const viewButtons = document.querySelectorAll('[data-view]');
    if (!recipeGrid || viewButtons.length === 0) return;

    viewButtons.forEach((btn) => {
      const active = (btn as HTMLElement).dataset.view === viewType;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });

    recipeGrid.classList.remove('view-grid', 'view-compact', 'view-list');
    recipeGrid.classList.add(`view-${viewType}`);

    localStorage.setItem('recipe-view-preference', viewType);
  }

  const savedView = localStorage.getItem('recipe-view-preference') || 'grid';
  setView(['grid', 'compact', 'list'].includes(savedView) ? savedView : 'grid');

  document.querySelectorAll('[data-view]').forEach((button) => {
    button.addEventListener('click', () => {
      setView((button as HTMLElement).dataset.view!);
    });
  });
</script>

<style>
  .view-controls {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1rem;
  }

  .view-buttons {
    display: flex;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.25rem;
  }

  .view-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .view-btn:hover {
    background: var(--accent);
    color: white;
  }

  .view-btn.active {
    background: var(--accent);
    color: white;
  }

  /* View mode styles */
  .view-grid {
    /* Grid styles are now in Layout.astro */
  }


</style>